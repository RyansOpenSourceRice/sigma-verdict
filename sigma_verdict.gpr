with "yaml";

library project Sigma_Verdict is
   for Languages use ("Ada");
   for Library_Name use "sigma_verdict";
   for Library_Kind use "static";
   for Source_Dirs use ("src", "boundary");
   for Object_Dir use "obj";
   for Library_Dir use "lib";
   for Create_Missing_Dirs use "True";

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatwa", "-gnata", "-gnato", "-O2");
   end Compiler;

   package Prove is
      for Proof_Switches ("Ada") use
        ("--mode=silver", "--level=2", "--checks-as-errors=on");
   end Prove;
end Sigma_Verdict;
