--  SPDX-License-Identifier: Apache-2.0
--
--  SPARK-only proof project: sees the pure core in src/, never the
--  adayaml boundary adapter (SPARK_Mode Off, unprovable by design).
--  Run with:
--    gnatprove -P proof/spark_core.gpr --mode=silver --level=2 \
--      --checks-as-errors=on

project Spark_Core is
   for Source_Dirs use ("../src", "units");
   for Object_Dir use "obj";

   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022");
   end Compiler;

   package Prove is
      for Proof_Switches ("Ada") use
        ("--mode=silver", "--level=2", "--checks-as-errors=on");
   end Prove;
end Spark_Core;
